# Copy to .env inside deploy/lightsail. NEVER commit the resulting .env file.
# First use HTTP-only public smoke testing. Switch to ./Caddyfile only at cutover.
CADDYFILE_PATH=./Caddyfile.http-test
PUBLICINFOHUB_PUBLISH_DIR=/opt/akeluwa/publicinfohub-publish
POSTGRES_DB=akeluwa
POSTGRES_USER=akeluwa
# Use long random alphanumeric/hex passwords (safe inside DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
MFA_ENCRYPTION_KEY=REPLACE_ME_DIFFERENT_FROM_JWT_SECRET
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME
# Configure together after deciding whether to create an initial admin account.
ADMIN_NAME=AKELUWA Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
