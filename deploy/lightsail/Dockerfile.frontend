# Native Next.js server build; do NOT use the Cloudflare/Vinext worker build here.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_SITE_URL=https://www.akeluwasoftwarehub.com.np
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV TOOLBOX_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN npm run build:vercel

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
# Keep Next's compiled app, route configuration and generated ToolBox files together.
COPY --from=build /app /app
EXPOSE 3000
CMD ["npm", "run", "start:vercel", "--", "-p", "3000", "-H", "0.0.0.0"]
