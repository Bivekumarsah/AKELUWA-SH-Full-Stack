APP_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://akeluwa:change-me@localhost:5432/akeluwa?sslmode=disable
# Optional isolated database used by the PostgreSQL integration tests.
TEST_DATABASE_URL=postgres://akeluwa:change-me@localhost:5432/akeluwa_test?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=akeluwa-api
MFA_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
SESSION_TTL=24h
COOKIE_NAME=akeluwa_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_NAME=AKELUWA Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
