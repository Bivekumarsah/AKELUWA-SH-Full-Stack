# Copy to .env inside deploy/lightsail. NEVER commit the resulting .env file.
# First use HTTP-only public smoke testing.
# For HTTPS staging, create only a staging DNS A record and select
# CADDYFILE_PATH=./Caddyfile.https-staging in the private .env file.
# Switch to ./Caddyfile only for final production cutover.
CADDYFILE_PATH=./Caddyfile.http-test
# During staging set these three lines in private .env (not this sample):
# COOKIE_DOMAIN=  (empty value = host-only cookie)
# CORS_ORIGINS=https://staging.akeluwasoftwarehub.com.np
# FRONTEND_URL=https://staging.akeluwasoftwarehub.com.np
PUBLICINFOHUB_PUBLISH_DIR=/opt/akeluwa/publicinfohub-publish
POSTGRES_DB=akeluwa
POSTGRES_USER=akeluwa
# Use long random alphanumeric/hex passwords (safe inside DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
MFA_ENCRYPTION_KEY=REPLACE_ME_DIFFERENT_FROM_JWT_SECRET
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME
# Configure together after deciding whether to create an initial admin account.
ADMIN_NAME=AKELUWA Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
