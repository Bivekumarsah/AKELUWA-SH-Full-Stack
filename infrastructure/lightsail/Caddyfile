# Switch to this only after HTTPS DNS records point to this instance.
www.akeluwasoftwarehub.com.np {
    encode zstd gzip

    @hub_no_slash path /publicinfohub
    redir @hub_no_slash /publicinfohub/ 308

    # Static site comes from the separately cloned PublicInfoHub repository.
    handle_path /publicinfohub/* {
        root * /srv/publicinfohub
        file_server
    }

    # Private Go backend: no separate public API port.
    handle /api/v1/* {
        reverse_proxy api:8080
    }

    # Includes the company and the integrated /akeluwatoolbox/ pages.
    handle {
        reverse_proxy frontend:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

akeluwasoftwarehub.com.np {
    redir https://www.akeluwasoftwarehub.com.np{uri} 308
}
