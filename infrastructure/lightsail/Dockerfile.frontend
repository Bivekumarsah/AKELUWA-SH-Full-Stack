# Native Next.js monorepo image. Preserve each tracked legacy symlink target:
# apps/company/toolbox -> ../toolbox
# apps/company/docs    -> ../../docs/company
# apps/company/backend -> ../../services/api
FROM node:22-bookworm-slim AS build
WORKDIR /workspace/apps/company
COPY apps/company/package.json apps/company/package-lock.json apps/company/.npmrc ./
RUN npm ci

COPY apps/company/ ./
COPY apps/toolbox/ /workspace/apps/toolbox/
COPY apps/publicinfohub/ /workspace/apps/publicinfohub/
COPY docs/company/ /workspace/docs/company/
COPY services/api/ /workspace/services/api/
# Fail early with a useful message if a monorepo symlink target is absent.
RUN test -f toolbox/index.html && test -f docs/ARCHITECTURE.md && test -f backend/go.mod

ARG NEXT_PUBLIC_SITE_URL=https://www.akeluwasoftwarehub.com.np
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV TOOLBOX_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN npm run build:vercel

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /workspace/apps/company
COPY --chown=node:node --from=build /workspace/apps/company/ ./
# Retain the same symlink layout at runtime. The Go API runs in its own
# private container; these files are present only for legacy frontend paths.
COPY --chown=node:node --from=build /workspace/apps/toolbox/ /workspace/apps/toolbox/
COPY --chown=node:node --from=build /workspace/docs/company/ /workspace/docs/company/
COPY --chown=node:node --from=build /workspace/services/api/ /workspace/services/api/
# The stock Node image provides an unprivileged node user. Cache and public
# assets are owned by this user; startup does not require root privileges.
USER node
EXPOSE 3000
CMD ["npm", "run", "start:vercel", "--", "-p", "3000", "-H", "0.0.0.0"]
