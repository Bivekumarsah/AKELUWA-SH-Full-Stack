# Build the canonical Next.js app plus its single shared Toolbox source.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace/apps/company
COPY apps/company/package.json apps/company/package-lock.json apps/company/.npmrc ./
RUN npm ci
COPY apps/company/ ./
COPY apps/toolbox/ ../toolbox/
COPY apps/publicinfohub/ ../publicinfohub/
ARG NEXT_PUBLIC_SITE_URL=https://www.akeluwasoftwarehub.com.np
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV TOOLBOX_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN npm run build:vercel

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /workspace/apps/company /app
EXPOSE 3000
CMD ["npm", "run", "start:vercel", "--", "-p", "3000", "-H", "0.0.0.0"]
