# Exclude secrets, local state and large derived artifacts from frontend builds.
.git
.gitignore
.github
node_modules
.next
dist
out
.wrangler
.vinext
.openai
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!deploy/lightsail/env.sample
deploy/backups
deploy/lightsail/backups
coverage
test-results
playwright-report
*.db
*.sqlite
*.sqlite3
*.dump
*.pem
*.key
*.crt
