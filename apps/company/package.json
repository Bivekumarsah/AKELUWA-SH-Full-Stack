{
  "name": "novastack-it-concept-0824",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-static-sites.mjs",
    "prebuild": "node scripts/build-static-sites.mjs",
    "build:toolbox": "node scripts/build-static-sites.mjs",
    "build:vercel": "npm run build:toolbox && next build --webpack",
    "dev:vercel": "npm run build:toolbox && next dev",
    "start:vercel": "next start",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "node scripts/with-wrangler-log.mjs vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "node scripts/with-wrangler-log.mjs vite build",
    "start": "node scripts/with-wrangler-log.mjs vinext start",
    "test": "npm run typecheck && npm run build && node --import ./tests/register-worker-loader.mjs --test tests/*.test.mjs",
    "test:docs": "node --import ./tests/register-worker-loader.mjs --test tests/documentation.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "deploy:frontend": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:frontend:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run audit:production"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.62.0",
    "@cloudflare/workers-types": "5.20260929.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "fflate": "0.7.5",
    "undici": "7.30.0"
  },
  "type": "module",
  "displayName": "NOVA/STACK IT Website Concept"
}
